# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-this-in-production
DATABASE_URL=sqlite:///ablelearn.db

# API Keys (Optional - for advanced features)
HUGGINGFACE_TOKEN=your_huggingface_token_here
GOOGLE_API_KEY=your_google_api_key_here

# Application Settings
DEFAULT_PORT=5000
DEBUG=True

# Content Limits
MAX_UPLOAD_SIZE=16777216  # 16MB in bytes
ALLOWED_EXTENSIONS=pdf,txt,docx,png,jpg,jpeg,gif

# AI Model Settings
USE_GPU=False  # Set to True if you have CUDA compatible GPU
MODEL_CACHE_SIZE=5000